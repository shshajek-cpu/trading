# 해시가 붙은 정적 자산은 영구 캐시해도 안전하다.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 글꼴은 내용이 바뀌지 않으므로 오래 캐시한다.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# 서비스워커와 진입 문서는 항상 새로 확인해야 갱신이 반영된다.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
